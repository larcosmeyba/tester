{
  "name": "@helpthehive/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "migrate:deploy": "tsx src/migrate.ts",
    "start": "tsx src/server.ts",
    "test": "node --import tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "sessions:invalidate": "tsx src/invalidate-sessions.ts",
    "schema:generate": "auth generate --config src/auth.ts --output migrations/pending.sql --yes",
    "migrate": "better-auth migrate --config src/auth.ts --yes"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.1",
    "@better-auth/infra": "^0.4.2",
    "@hono/node-server": "^1.19.9",
    "better-auth": "^1.7.1",
    "dotenv": "^17.2.3",
    "hono": "^4.11.9",
    "jose": "^6.2.10",
    "pg": "^8.18.0",
    "resend": "^6.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.13",
    "@types/pg": "^8.15.6",
    "auth": "^1.7.1",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  }
}
