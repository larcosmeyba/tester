PORT=3000
DATABASE_URL=postgres://helpthehive:helpthehive@localhost:54328/helpthehive?sslmode=disable
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_AUDIENCE=http://localhost:8080
AUTH_CORS_ALLOWED_ORIGINS=http://localhost:8081
MOBILE_AUTH_CALLBACK_URL=helpthehive://auth

# Sign in with Apple. APPLE_CLIENT_ID is the Services ID; the bundle identifier
# is the native App ID. Store the .p8 key as one line with literal \n escapes or
# as a quoted multiline value.
APPLE_CLIENT_ID=com.example.helpthehive.signin
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID
APPLE_KEY_ID=YOUR_APPLE_KEY_ID
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----"
APPLE_APP_BUNDLE_IDENTIFIER=com.helpthehive.HelpTheHive

# Google OAuth Web application credentials. Register
# $BETTER_AUTH_URL/api/auth/callback/google as an authorized redirect URI.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_WEB_CLIENT_SECRET

# Leave blank locally to use the safe development transport.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Help The Hive <auth@example.com>

# Create a project at https://dash.better-auth.com and copy its API key here.
# The dashboard integration is optional locally and required when NODE_ENV=production.
BETTER_AUTH_API_KEY=
# Override only when using custom Better Auth Infrastructure endpoints.
# BETTER_AUTH_API_URL=https://dash.better-auth.com
# BETTER_AUTH_KV_URL=https://kv.better-auth.com
