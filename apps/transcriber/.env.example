APP_ENV=development
PORT=8090

# The extraction provider. A base URL plus a model name, following the same
# convention as MEAL_AI_* on the Go server: switching vendors is configuration,
# not a code change. Any OpenAI-compatible endpoint works.
RECIPE_AI_BASE_URL=https://api.openai.com/v1
RECIPE_AI_MODEL=gpt-4o-mini
RECIPE_AI_API_KEY=

# Speech to text, used only when a video has no usable captions.
RECIPE_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Shared secret the Go API server presents as `Authorization: Bearer <secret>`.
# Required whenever APP_ENV=production — the service fails closed without it.
#
# This is a server secret. It must never appear in an EXPO_PUBLIC_* variable or
# anywhere in the mobile bundle, which anyone who installs the app can read.
IMPORT_SHARED_SECRET=

# Hosts video links may point at. Comma separated. Keep this tight: the service
# fetches whatever URL it is handed.
IMPORT_ALLOWED_HOSTS=youtube.com,www.youtube.com,m.youtube.com,youtu.be,instagram.com,www.instagram.com,tiktok.com,www.tiktok.com,vm.tiktok.com

IMPORT_MAX_DURATION_SECONDS=3600
IMPORT_JOB_TTL_SECONDS=3600
IMPORT_MAX_CONCURRENCY=4
