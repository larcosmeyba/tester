APP_ENV=development
HTTP_ADDR=:8080
CORS_ALLOWED_ORIGINS=http://localhost:8081,exp://*

DATABASE_URL=postgres://helpthehive:helpthehive@localhost:54328/helpthehive?sslmode=disable
TEST_DATABASE_URL=postgres://helpthehive:helpthehive@localhost:54328/helpthehive_test?sslmode=disable

BETTER_AUTH_ISSUER=http://localhost:3000
BETTER_AUTH_AUDIENCE=http://localhost:8080
BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks

# Meal AI provider. Leave MEAL_AI_PROVIDER unset and the meal system runs
# entirely deterministically: plans are built, priced and explained by the
# server with no model involved.
#
# Set it to "openai_compatible" to have Penny's message written by a provider.
# The provider is a base URL and a model name, so switching vendors is
# configuration, not a code change. Set it to "anthropic" to use Claude via
# Anthropic's Messages API instead: MEAL_AI_BASE_URL then defaults to
# https://api.anthropic.com and MEAL_AI_MODEL to claude-haiku-4-5, so only
# MEAL_AI_API_KEY is required.
#
# MEAL_AI_API_KEY is a server secret. It must never appear in an EXPO_PUBLIC_*
# variable or anywhere in the mobile bundle, which anyone who installs the app
# can read. Put the real value in .env, which is gitignored — never here.
MEAL_AI_PROVIDER=
MEAL_AI_BASE_URL=
MEAL_AI_MODEL=
MEAL_AI_API_KEY=

# Recipe import (video → recipe). Optional: leave RECIPE_IMPORT_URL unset and
# the server runs exactly as it does today, with video import reported as
# unavailable rather than failing at boot.
#
# RECIPE_IMPORT_URL is the extraction service's internal address. It must not
# be publicly reachable: the service trusts this server to say who an import
# belongs to, which is only safe behind internal-only ingress.
#
# IMPORT_SHARED_SECRET is shared with that service. Like MEAL_AI_API_KEY it is
# a server secret — never in an EXPO_PUBLIC_* variable, and never here. Put the
# real value in .env, which is gitignored.
RECIPE_IMPORT_URL=
IMPORT_SHARED_SECRET=

# Optional tuning. Starting an import is a short call; polling is shorter.
# Only polls are retried — starting one spends a transcription.
RECIPE_IMPORT_START_TIMEOUT=10s
RECIPE_IMPORT_POLL_TIMEOUT=5s
RECIPE_IMPORT_POLL_ATTEMPTS=3

# Import limits. Every attempt buys a transcription, so these bound spend
# rather than maximise throughput. Unset means the built-in defaults.
#
#   MAX_ATTEMPTS     extractions one import may pay for, including the first
#   RATE_LIMIT       imports one user may start per RATE_WINDOW
#   STALE_AFTER      how quiet an unfinished import must be before the worker
#                    picks it up
#   RUNNING_TIMEOUT  how long an import may run before it is treated as stuck
#                    and retried or failed — nothing stays running forever
RECIPE_IMPORT_MAX_ATTEMPTS=3
RECIPE_IMPORT_RATE_LIMIT=10
RECIPE_IMPORT_RATE_WINDOW=1h
RECIPE_IMPORT_STALE_AFTER=2m
RECIPE_IMPORT_RUNNING_TIMEOUT=15m

# --- Penny -----------------------------------------------------------------
#
# Penny is off unless PENNY_AGENT_URL is set, and the server runs correctly with
# her off: the chat reports itself unavailable and nothing else changes. A
# half-configured Penny is a start-up failure rather than a surprise on
# somebody's first message.

# The agent service (apps/penny). Empty disables Penny.
PENNY_AGENT_URL=
# Shared with the agent. Proves a turn request came from this server, and
# authenticates the agent when it calls back to the tool gateway.
PENNY_SERVICE_TOKEN=
# Signs the per-turn tool tokens. At least 32 characters: a forgeable token is a
# tool call running as a user who did not ask for it. Never leaves this process
# except as a signature.
#   openssl rand -hex 32
PENNY_TOOL_TOKEN_SECRET=

# --- Recipe images & price-per-serving (Spoonacular) --------------------------
#
# Powers the Recipe Database's images and price-per-serving figures
# (internal/modules/spoonacular). Optional: with no key the server runs
# exactly as it does today and recipe views report the enrichment as
# unavailable.
#
# SPOONACULAR_API_KEY is a server secret. It must never appear in an
# EXPO_PUBLIC_* variable or anywhere in the mobile bundle, which anyone who
# installs the app can read. Put the real value in .env, which is gitignored
# — never here.
SPOONACULAR_API_KEY=<redacted>

# --- Live grocery pricing (Kroger) --------------------------------------------
#
# Powers live per-store pricing (internal/modules/kroger) via OAuth2 client
# credentials. Optional and stubbed: the Help The Hive developer app must be
# approved at developer.kroger.com (~1–2 week review) before these do
# anything. With no credentials the server prices from USDA averages and
# labels every number "Est.".
#
# Users do NOT need Kroger accounts: these credentials authorize Help The
# Hive's app, and the store is picked from the phone's location.
#
# KROGER_CLIENT_ID and KROGER_CLIENT_SECRET are server secrets. They must
# never appear in an EXPO_PUBLIC_* variable or anywhere in the mobile bundle.
# Put the real values in .env, which is gitignored — never here.
KROGER_CLIENT_ID=<redacted>
KROGER_CLIENT_SECRET=<redacted>
