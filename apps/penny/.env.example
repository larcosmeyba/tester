# Penny agent service.
#
# There is no DATABASE_URL in this file, and there must never be one. This
# process is the one that hands text to a third-party model, and it is deployed
# without database credentials so that "the model cannot modify the database" is
# a fact about the deployment rather than a rule someone has to remember. Every
# read and every write goes back through the Help The Hive backend.

PENNY_HOST=0.0.0.0
PENNY_PORT=8081
PENNY_ENV=development
PENNY_LOG_LEVEL=info

# The Help The Hive backend. Tool calls go here and nowhere else.
PENNY_BACKEND_URL=http://localhost:8080
# Shared with the Go server. Proves a turn request came from it, and
# authenticates this service when it calls back to the tool gateway.
# Must match PENNY_SERVICE_TOKEN on the server.
PENNY_SERVICE_TOKEN=

# Provider: fake | anthropic | openai_compatible
# "fake" is the default and needs no key. It is deterministic, which is what
# makes the eval suite runnable in CI.
PENNY_PROVIDER=fake
PENNY_MODEL=claude-sonnet-5
PENNY_API_KEY=
# Only for openai_compatible.
PENNY_BASE_URL=

# How much of a turn the model may spend.
PENNY_MAX_TOOL_CALLS=8
PENNY_MAX_OUTPUT_TOKENS=800
PENNY_REQUEST_TIMEOUT_SECONDS=60
