# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS build

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
WORKDIR /workspace

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/auth/package.json apps/auth/package.json
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --filter @helpthehive/auth --frozen-lockfile

COPY apps/auth apps/auth
RUN pnpm --filter @helpthehive/auth build \
    && pnpm --filter @helpthehive/auth deploy --legacy --prod /opt/auth

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production
ENV PORT=8080
WORKDIR /app

COPY --from=build --chown=node:node /opt/auth/node_modules ./node_modules
COPY --from=build --chown=node:node /workspace/apps/auth/dist ./dist
COPY --from=build --chown=node:node /workspace/apps/auth/migrations ./migrations
COPY --from=build --chown=node:node /workspace/apps/auth/package.json ./package.json

USER node
EXPOSE 8080
CMD ["node", "dist/server.js"]
